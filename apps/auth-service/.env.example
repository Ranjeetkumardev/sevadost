# Environment
NODE_ENV=development

# Server Port
PORT=4001

# Database
MONGODB_URI=mongodb://localhost:27017/sevadost_auth

# JWT Secrets (generate strong random strings for production)
ACCESS_SECRET=your_access_token_secret_key_here_change_in_production
REFRESH_SECRET=your_refresh_token_secret_key_here_change_in_production

# JWT Expiry Times
ACCESS_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d
